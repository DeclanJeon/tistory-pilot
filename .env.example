# Optional: reuse SMTP + owner email from another project env file.
# Example: /home/declan/Documents/Develop/Project/pons_p2p/ponslink-api-infra/.env
TISTORY_ENV_FILE=
TISTORY_BLOG_URL=https://YOURBLOG.tistory.com
TISTORY_POST_TITLE=agbrowse test post
TISTORY_POST_BODY=첫 번째 줄\n\n두 번째 줄
TISTORY_POST_DESCRIPTION=간단한 설명
TISTORY_POST_TAGS=agbrowse,tistory,automation
TISTORY_POST_CATEGORY=IT·테크
TISTORY_POST_HERO_IMAGE=assets/example.png
TISTORY_HEADED=1
TISTORY_QR_IMAGE_PATH=tmp/kakao-tistory-qr.png
TISTORY_WAIT_FOR_LOGIN_MS=300000
TISTORY_QR_EMAIL_TO=
TISTORY_QR_EMAIL_ON_REFRESH=0
TISTORY_QR_EMAIL_SUBJECT_PREFIX=[Tistory QR]
TISTORY_QR_EMAIL_FROM=
TISTORY_SMTP_HOST=
TISTORY_SMTP_PORT=587
TISTORY_SMTP_SECURE=0
TISTORY_SMTP_USER=
TISTORY_SMTP_PASS=
# Compatibility: the QR mailer also accepts SMTP_HOST/SMTP_PORT/SMTP_SECURE/SMTP_USER/SMTP_PASS/SMTP_FROM
# and will fall back to PONSLINK_PROVIDER_DASHBOARD_OWNER_EMAIL or CONTACT_EMAIL as the recipient when available.
TISTORY_SOURCE_URLS=https://example.com/article-a,https://example.com/article-b
TISTORY_SOURCE_OUTPUT_DIR=tmp/source-imports
TISTORY_SOURCE_IMAGE_LIMIT=3
TISTORY_SOURCE_PARAGRAPHS=12
TISTORY_SOURCE_IMAGE_EVERY=3
TISTORY_DOWNLOAD_SOURCE_HERO=1

# LLM content generation (Xiaomi MiMo)
LLM_PROVIDER=openai-compat
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5

# Discord publish notifications
DISCORD_WEBHOOK_ENABLED=0
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_QA_PASS=0

# Market demand discovery. Empty seed fields mean the scheduler derives
# current interests from Google Trends/KMA first, then queries Naver providers.
MARKET_SEED_KEYWORDS=
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=
NAVER_DATALAB_KEYWORDS=
# Hard ceiling from the current DataLab quota; may be lowered, never raised.
NAVER_DATALAB_MONTHLY_LIMIT=50000
NAVER_DATALAB_USAGE_FILE=

# Representative images: Google usage-rights discovery → Codex Imagen fallback.
CODEX_IMAGEN_SCRIPT=
# Set only when the helper uses a non-default Python executable.
CODEX_IMAGEN_PYTHON=python3
CODEX_IMAGEN_TIMEOUT_SEC=300
CODEX_IMAGEN_RETRIES=1
IMAGE_ALLOWED_HOSTS=wikimedia.org,unsplash.com,pexels.com,pixabay.com,pxhere.com,openclipart.org,gov.kr,go.kr,korea.kr,data.go.kr
IMAGE_ALLOW_UNVERIFIED_SOURCE=0
IMAGE_ALLOW_PIL_FALLBACK=0
