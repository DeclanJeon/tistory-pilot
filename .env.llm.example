# ── LLM 설정 (콘텐츠 생성용) ──────────────────────────────────────────
#
# .env.local 에 아래를 넣고 LLM_API_KEY 만 채운다.
#
# ┌─────────────────────────────────────────────────────────────────┐
# │  Xiaomi MiMo v2.5 공식 API                                     │
# ├─────────────────────────────────────────────────────────────────┤
# │  1. https://platform.xiaomimimo.com 접속                       │
# │  2. Console → API Keys 에서 키 발급 (sk-xxxxx)                 │
# │  3. LLM_API_KEY 에 붙여넣기                                    │
# │                                                                │
# │  Base URL : https://api.xiaomimimo.com/v1                      │
# │  Model    : mimo-v2.5  /  mimo-v2.5-pro                        │
# │  Auth     : Authorization: Bearer $KEY  또는  api-key: $KEY    │
# └─────────────────────────────────────────────────────────────────┘
#
LLM_PROVIDER=openai-compat
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_API_KEY=              # ← Xiaomi MiMo API 키
LLM_MODEL=mimo-v2.5

# Hermes 연동 (대안)
# hermes auth add xiaomi --type api-key --api-key $XIAOMI_API_KEY
# hermes config set model.provider xiaomi
# hermes config set model.default mimo-v2.5
# hermes ~/.hermes/.env 에:
#   XIAOMI_API_KEY=sk-xxxxx
#   XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
#
# nous 로그인 명령은 login 이 아니라:
#   hermes auth add nous

# Discord webhook (발행 성공/실패 알림)
DISCORD_WEBHOOK_ENABLED=1
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_QA_PASS=0
